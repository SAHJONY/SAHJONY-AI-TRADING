{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash scripts/build_public_config.sh",
  "outputDirectory": "public",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": {
      "master": true
    }
  },
  "headers": [
    { "source": "/status.json", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/robinhood.json", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/api/promotion-status", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/api/runtime-status", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/api/broker-evidence", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/api/finnhub", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
