{
  "name": "sahjony-parquet-terminal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:ui\" \"npm:dev:server\"",
    "dev:ui": "vite --config parquet/vite.config.ts",
    "dev:server": "tsx parquet/server/index.ts",
    "build": "sh scripts/build_parquet.sh",
    "typecheck": "tsc -p parquet/tsconfig.json --noEmit",
    "test:parquet": "node --test parquet/server/*.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "cors": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "vite": "latest",
    "ws": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "latest",
    "autoprefixer": "latest",
    "concurrently": "latest",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "tsx": "latest",
    "typescript": "latest"
  }
}
